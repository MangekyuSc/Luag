        TextXAlignment = Enum.TextXAlignment.Left
    }, terminal)
end

-- LOADING ANIMATION
local duration = math.random(120, 180)
local startTime = os.clock()
local nextLog = 1

addLog("Starting Elysium loader...")

while gui.Parent do
    local elapsed = os.clock() - startTime
    local progress = math.clamp(elapsed / duration, 0, 1)

    percentage.Text = string.format(
        "%.1f%%",
        progress * 100
    )

    TweenService:Create(
        bar,
        TweenInfo.new(0.15),
        {
            Size = UDim2.new(progress, 0, 1, 0)
        }
    ):Play()

    if nextLog <= #logs
        and progress >= nextLog / (#logs + 1) then

        addLog(logs[nextLog])
        nextLog += 1
    end

    if progress >= 1 then
        break
    end

    task.wait(0.1)
end

