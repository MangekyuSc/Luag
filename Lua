local Messages = {
	"Loading assets...",
	"Setting things up...",
	"Preparing environment...",
	"Finalizing..."
}

local function CompleteStep(Index)
	local Data = Steps[Index]

	TweenService:Create(Data.Circle, TweenInfo.new(0.25), {
		BackgroundColor3 = Color3.fromRGB(95, 48, 12)
	}):Play()

	TweenService:Create(Data.Stroke, TweenInfo.new(0.25), {
		Color = ORANGE_LIGHT
	}):Play()

	Data.Check.Text = "✓"
	Data.Label.TextColor3 = WHITE
end

-- Progress timer
local StartTime = os.clock()
local Completed = {}

while true do
	local Elapsed = os.clock() - StartTime
	local ProgressAmount = math.clamp(Elapsed / DURATION, 0, 1)
	local Percentage = math.floor(ProgressAmount * 100)

	Percent.Text = Percentage .. "%"
	BarFill.Size = UDim2.new(ProgressAmount, 0, 1, 0)

	for i = 1, 3 do
		local Segment = math.clamp(
			ProgressAmount * 3 - (i - 1),
			0,
			1
		)

		Steps[i].Fill.Size = UDim2.new(Segment, 0, 1, 0)
	end

	for i = 1, 4 do
		if ProgressAmount >= i / 4 and not Completed[i] then
			Completed[i] = true
			CompleteStep(i)
			InfoText.Text = Messages[i]
		end
	end

	if ProgressAmount >= 1 then
		break
	end

	task.wait(0.1)
end

Percent.Text = "100%"
InfoText.Text = "Loading complete!"
HeaderText.Text = "READY"

-- Final 10-second phase
local FinalStart = os.clock()

while os.clock() - FinalStart < FINAL_PHASE do
	local Remaining = math.ceil(
		FINAL_PHASE - (os.clock() - FinalStart)
	)

	InfoText.Text = "Finishing... " .. Remaining .. "s"
	task.wait(0.1)
end

local success, err = pcall(function()
	local url = "https://raw.githubusercontent.com/hanniii1/Loader/refs/heads/main/BFLoader.lua"
	local source = game:HttpGet(url)
	local loader = assert(loadstring(source), "BFLoader compilation failed")
	task.spawn(loader)
end)

if not success then
	warn("[ELYSIUM] BFLoader error:", err)
end

InfoText.Text = "Complete!"
HeaderText.Text = "READY"

-- Fade out and destroy
task.wait(1)

local FadeInfo = TweenInfo.new(
	1,
	Enum.EasingStyle.Quad,
	Enum.EasingDirection.Out
)

for _, Object in ipairs(Gui:GetDescendants()) do
	if Object:IsA("Frame") then
		TweenService:Create(Object, FadeInfo, {
			BackgroundTransparency = 1
		}):Play()
	elseif Object:IsA("TextLabel") then
		TweenService:Create(Object, FadeInfo, {
			TextTransparency = 1,
			BackgroundTransparency = 1
		}):Play()
	elseif Object:IsA("UIStroke") then
		TweenService:Create(Object, FadeInfo, {
			Transparency = 1
		}):Play()
	end
end

TweenService:Create(Main, FadeInfo, {
	BackgroundTransparency = 1
}):Play()

task.wait(1.1)
Gui:Destroy()
