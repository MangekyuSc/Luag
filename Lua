-- CREATION FUNCTION
local function create(class, props, parent)
    local obj = Instance.new(class)

    for k, v in pairs(props) do
        obj[k] = v
    end

    if obj:IsA("GuiObject") then
        obj.ZIndex = 3
    end

    obj.Parent = parent
    return obj
end

